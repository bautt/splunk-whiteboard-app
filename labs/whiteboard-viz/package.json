{
  "name": "whiteboard_viz",
  "version": "0.1.0",
  "description": "Renders Whiteboard App boards live inside Dashboard Studio (experimental, Splunk 10.4+)",
  "author": "Tomas Baublys",
  "type": "module",
  "scripts": {
    "build": "node build.mjs --entry=visualization.jsx",
    "build:prod": "NODE_ENV=production node build.mjs --entry=visualization.jsx",
    "dev": "node build.mjs --entry=visualization.jsx --watch",
    "package": "node package.mjs"
  },
  "devDependencies": {
    "@excalidraw/excalidraw": "^0.17.6",
    "@splunk/dashboard-studio-extension": "^1.0.0",
    "@splunk/react-ui": "^5.9.0",
    "@splunk/themes": "^1.4.0",
    "chalk": "^5.3.0",
    "esbuild": "^0.27.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "styled-components": "^5.3.10",
    "tar": "^7.4.3"
  }
}
